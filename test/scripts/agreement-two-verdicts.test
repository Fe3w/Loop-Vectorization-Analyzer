# One loop, two verdicts (AArch64): "vectorization not beneficial" and then
# "interleaved" at the same location belong to the same loop -- one row, not two.
# RUN: rm -rf %t && mkdir -p %t
# RUN: %python %S/../../scripts/agreement.py --raw %S/Inputs/agree/twoverdicts --out %t
# RUN: FileCheck --check-prefix=CSV %s < %t/agreement.csv
# RUN: FileCheck --check-prefix=SUM %s < %t/agreement_summary.csv
